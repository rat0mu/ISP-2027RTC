# Normalize text line endings for shared sources.
* text=auto
*.md text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf
*.kicad_pro text eol=lf
*.ioc text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
*.docx binary
