# Runtime outputs: place regenerable output in these explicit locations
ground_station/logs/
ground_station/reports/
tools/output/
tests/output/
*.log

# CSV, BOM, Gerber and calibration inputs are NOT globally ignored.
# Keep small required test inputs and versioned release evidence deliberately.
# Review before adding large generated assets.
